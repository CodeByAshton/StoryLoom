{
  "name": "motif",
  "version": "0.1.0",
  "description": "Motif: an AI writing studio for novelists in Obsidian, with writing tools, a chapter-by-chapter codex and AI review.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "vault": "npm run build && node scripts/install-vault.mjs",
    "test": "vitest run",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "writing",
    "ai"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@types/node": "^22.20.5",
    "esbuild": "^0.24.2",
    "obsidian": "^1.14.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
